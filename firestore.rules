rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /projects/{projectId} {
      // Drafts and archived records are never returned to a public client.
      allow get, list: if (resource.data.published == true && resource.data.archived == false) || isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
